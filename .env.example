# MongoDB connection string (used when running the API outside Docker Compose)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/grocery_store

# JWT signing secret
JWT_SECRET=replace_with_a_long_random_secret

# Separate MongoDB connection string for Jest tests
TEST_MONGODB_URI=<your_test_database_connection_string>

# Local MongoDB credentials for Docker Compose
MONGO_ROOT_USERNAME=grocery_admin
MONGO_ROOT_PASSWORD=replace_with_a_local_password